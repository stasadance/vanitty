---
// Built from the app's own JSON schema and defaults, so it can't drift.
import { SETTINGS_SCHEMA } from "../../../src/config/schema";
import { DEFAULT_CONFIG } from "../../../src/config/defaults";

const defaults = DEFAULT_CONFIG as Record<string, unknown>;
const typeOf = (p: any): string =>
  p.enum ? p.enum.map((v: unknown) => JSON.stringify(v)).join(" | ")
  : Array.isArray(p.type) ? p.type.join(" | ")
  : p.format === "color" ? "color"
  : p.type ?? "";
// Long values such as font stacks are left out; the schema in your config folder has them.
const fmt = (v: unknown) => {
  const s = v === undefined || (typeof v === "object" && !(Array.isArray(v) && !v.length)) ? "" : JSON.stringify(v);
  return s.length > 32 ? "" : s;
};
const rows = Object.entries(SETTINGS_SCHEMA.properties as Record<string, any>)
  .filter(([k]) => k !== "$schema")
  .map(([k, p]) => ({ key: k, type: typeOf(p), def: fmt(defaults[k]), desc: p.description ?? "" }));
---
<table>
  <thead><tr><th>Setting</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
  <tbody>
    {rows.map((r) => (
      <tr><td><code>{r.key}</code></td><td>{r.type}</td><td>{r.def && <code>{r.def}</code>}</td><td>{r.desc}</td></tr>
    ))}
  </tbody>
</table>
