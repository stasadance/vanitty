# Maintainer: Stas <stas@kognova.ai>
# Builds Vanitty from the latest main branch. The repo is private, so git
# needs access to it (e.g. a GitHub credential helper or SSH key).
#
#   cd packaging/arch && makepkg -si

pkgname=vanitty-git
_pkgname=vanitty
pkgver=26.10.0.r0.g0000000
pkgrel=1
pkgdesc="A fast, native terminal. A Rust + Tauri rewrite of Hyper"
arch=('x86_64' 'aarch64')
url="https://vanitty.dev"
license=('MIT' 'OFL-1.1')
depends=('webkit2gtk-4.1' 'gtk3' 'hicolor-icon-theme')
makedepends=('git' 'cargo' 'nodejs' 'pnpm')
provides=("$_pkgname")
conflicts=("$_pkgname")
# Cargo's release profile already uses LTO; makepkg's flags would clash.
options=('!lto' '!debug')
source=("$_pkgname::git+https://github.com/stasadance/vanitty.git"
        "$_pkgname.desktop")
sha256sums=('SKIP'
            'SKIP')

pkgver() {
  cd "$_pkgname"
  printf "%s.r%s.g%s" \
    "$(node -p "require('./package.json').version")" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_pkgname"
  pnpm install --frozen-lockfile
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --manifest-path src-tauri/Cargo.toml --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  pnpm tauri build --no-bundle -- --frozen
}

package() {
  cd "$_pkgname"
  install -Dm755 src-tauri/target/release/$_pkgname "$pkgdir/usr/bin/$_pkgname"
  install -Dm644 "$srcdir/$_pkgname.desktop" "$pkgdir/usr/share/applications/$_pkgname.desktop"
  install -Dm644 src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/$_pkgname.png"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/$_pkgname.png"
  install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/$_pkgname.png"
  install -Dm644 src-tauri/icons/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/$_pkgname.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 public/fonts/LICENSE-FiraCode-NerdFont.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE-FiraCode-NerdFont.txt"
}
